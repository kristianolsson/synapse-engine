#!/bin/bash
# synapse — unified setup/deploy dispatcher for synapse-engine.
# Replaces install.sh, stop.sh, update.sh, and the manual QNAP docker commands.
set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$PROJECT_DIR"

# QNAP data root — the live .env lives here, not in the repo (see docker-compose.yml's
# env_file: directive and qnap-setup.md).
QNAP_DATA_DIR="/share/CE_CACHEDEV2_DATA/synapse"

TARGET=""
ENV_FILE=""

# Sets the TARGET and ENV_FILE globals. Must be called directly (not in a
# `$(...)` subshell) or the assignments are lost.
detect_target() {
    if [[ "$(uname -s)" == "Darwin" ]]; then
        TARGET="mac"
        ENV_FILE="$PROJECT_DIR/.env"
    else
        TARGET="qnap"
        ENV_FILE="$QNAP_DATA_DIR/.env"
    fi
}

detect_target

# Prefer .venv, fall back to venv, then the system python3 — matches _detect_venv_dir.
_detect_python() {
    if [ -x "$PROJECT_DIR/.venv/bin/python3" ]; then
        echo "$PROJECT_DIR/.venv/bin/python3"
    elif [ -x "$PROJECT_DIR/venv/bin/python3" ]; then
        echo "$PROJECT_DIR/venv/bin/python3"
    else
        echo "python3"
    fi
}

cmd_services() {
    PYTHON="$(_detect_python)"
    # Source the env file so ENABLED_SERVICES is visible to the python subprocess.
    # Missing file (fresh install) is fine — everything just reports as disabled.
    if [ -f "$ENV_FILE" ]; then
        set -a
        # shellcheck disable=SC1090
        source "$ENV_FILE" 2>/dev/null || true
        set +a
    fi
    "$PYTHON" -c "
from pathlib import Path
from services.ingestion.registry import ServiceRegistry
import os
registry = ServiceRegistry.discover(Path('services/ingestion/services'))
enabled = {s.strip().lower() for s in os.getenv('ENABLED_SERVICES', '').split(',') if s.strip()}
for name, spec in sorted(registry.services.items()):
    status = 'enabled' if name in enabled else 'disabled'
    print(f'{name:15} [{spec.kind:8}] {status:10} {spec.description}')
"
}

cmd_logs() {
    if [[ "$TARGET" == "mac" ]]; then
        tail -f /tmp/synapse-ingestion.out.log /tmp/synapse-ingestion.err.log
    else
        docker compose logs -f
    fi
}

LAUNCH_AGENTS="$HOME/Library/LaunchAgents"
PLIST_NAME="com.synapse.ingestion.plist"
LABEL="com.synapse.ingestion"

_detect_node_bin() {
    if command -v node &>/dev/null; then
        dirname "$(command -v node)"
    elif [ -d "$HOME/.nvm" ]; then
        find "$HOME/.nvm/versions/node" -maxdepth 2 -name bin -type d 2>/dev/null | sort -V | tail -1
    else
        echo ""
    fi
}

_detect_venv_dir() {
    if [ -f "$PROJECT_DIR/.venv/bin/python" ]; then
        echo ".venv"
    elif [ -f "$PROJECT_DIR/venv/bin/python" ]; then
        echo "venv"
    else
        echo ""
    fi
}

cmd_setup_mac() {
    NODE_BIN="$(_detect_node_bin)"
    if [ -z "$NODE_BIN" ]; then
        echo "⚠️  Could not find node. Gemini CLI may not work."
        NODE_BIN="/usr/local/bin"
    fi

    VENV_DIR="$(_detect_venv_dir)"
    if [ -z "$VENV_DIR" ]; then
        echo "❌ venv not found. Create one (.venv or venv) and install requirements."
        exit 1
    fi

    if [ ! -f "$PROJECT_DIR/.env" ]; then
        echo "❌ .env not found. Run: cp .env.example .env"
        exit 1
    fi

    # Runs after the .env/venv guards above so a genuinely fresh clone hits those
    # errors first — scaffolding would otherwise create a one-line .env and
    # permanently defeat the "cp .env.example .env" check.
    _maybe_scaffold_vault

    _prompt_services

    sed \
        -e "s|__PROJECT_DIR__|$PROJECT_DIR|g" \
        -e "s|__NODE_BIN__|$NODE_BIN|g" \
        -e "s|__VENV_DIR__|$VENV_DIR|g" \
        "$PROJECT_DIR/com.synapse.ingestion.plist.template" > "$PROJECT_DIR/$PLIST_NAME"

    echo "✅ Generated $PLIST_NAME (PROJECT_DIR=$PROJECT_DIR, NODE_BIN=$NODE_BIN, VENV_DIR=$VENV_DIR)"

    echo "Stopping existing service (if running)..."
    launchctl unload "$LAUNCH_AGENTS/$PLIST_NAME" 2>/dev/null || true
    sleep 2

    mkdir -p "$LAUNCH_AGENTS"
    cp "$PROJECT_DIR/$PLIST_NAME" "$LAUNCH_AGENTS/$PLIST_NAME"
    launchctl enable "gui/$(id -u)/$LABEL" 2>/dev/null || true
    launchctl load -w "$LAUNCH_AGENTS/$PLIST_NAME"

    echo "✅ Service installed and started. Logs: ./synapse logs"
}

cmd_start_mac() {
    launchctl load -w "$LAUNCH_AGENTS/$PLIST_NAME"
    echo "Service started."
}

cmd_stop_mac() {
    if [[ "${2:-}" == "--persist" ]]; then
        launchctl load -w "$LAUNCH_AGENTS/$PLIST_NAME" 2>/dev/null || true
        launchctl unload -w "$LAUNCH_AGENTS/$PLIST_NAME" 2>/dev/null || true
        echo "Service stopped and disabled — won't restart on login/reboot. Re-enable with: ./synapse setup"
    else
        if launchctl unload "$LAUNCH_AGENTS/$PLIST_NAME" 2>/dev/null; then
            echo "Service stopped."
        else
            echo "Service was not running."
        fi
        echo "FYI: won't survive reboot/login (RunAtLoad restarts it). Use './synapse stop --persist' to disable permanently."
    fi
}

cmd_restart_mac() {
    cmd_stop_mac
    sleep 2  # ensures the old process has fully exited before reloading
    cmd_start_mac
}

cmd_update_mac() {
    echo "Pulling latest code..."
    git pull
    cmd_restart_mac
}

cmd_setup_qnap() {
    _maybe_scaffold_vault
    _prompt_services
    echo "Building and starting containers..."
    docker compose --env-file "$ENV_FILE" build
    docker compose up -d
    echo "✅ Started. Logs: ./synapse logs"
}

cmd_start_qnap() {
    docker compose up -d
}

cmd_stop_qnap() {
    docker compose down
}

cmd_restart_qnap() {
    docker compose restart
}

# Runs a local git script inside a throwaway alpine/git container against
# vault_dir, mirroring _qnap_git_pull's approach — QNAP has no usable host
# git. Restores ownership to the synapse user afterward.
#
# Deliberately mounts NO SSH key: init/commit/remote-add are all local
# operations. Mounting a not-yet-provisioned key path would make Docker create
# a *directory* at that host path, which then gets bind-mounted into the real
# app container (see docker-compose.yml) and breaks every future vault push.
# Use _qnap_git_in_container_with_ssh for operations that talk to a remote.
_qnap_git_in_container() {
    local vault_dir="$1"
    local script="$2"
    local rc=0
    docker run --rm --entrypoint sh \
        -v "$vault_dir:$vault_dir" \
        alpine/git \
        -c "git config --global --add safe.directory '$vault_dir' && \
            cd '$vault_dir' && $script" || rc=$?
    chown -R synapse "$vault_dir" || true
    return $rc
}

# Same as above but with the SSH deploy key mounted, for operations that reach a
# remote. Refuses to run (rather than mounting a missing path) when the key is
# absent, so a fresh QNAP can never get a poisoned directory at the key path.
_qnap_git_in_container_with_ssh() {
    local vault_dir="$1"
    local script="$2"
    local key_path="$QNAP_DATA_DIR/ssh/id_ed25519"
    if [ ! -f "$key_path" ]; then
        echo "⚠️  SSH deploy key not found at $key_path — cannot push, skipping."
        return 1
    fi
    local rc=0
    docker run --rm --entrypoint sh \
        -v "$vault_dir:$vault_dir" \
        -v "$key_path:/root/.ssh/id_ed25519" \
        alpine/git \
        -c "chmod 600 /root/.ssh/id_ed25519 && \
            git config --global --add safe.directory '$vault_dir' && \
            cd '$vault_dir' && $script" || rc=$?
    chown -R synapse "$vault_dir" || true
    return $rc
}

_qnap_vault_git_init() {
    local vault_dir="$1"
    local git_name git_email
    git_name="$(_env_var GIT_USER_NAME)"
    git_name="${git_name:-synapse-engine}"
    git_email="$(_env_var GIT_USER_EMAIL)"
    git_email="${git_email:-synapse-engine@localhost}"
    _qnap_git_in_container "$vault_dir" \
        "git init -q && git config user.name '$git_name' && git config user.email '$git_email' && git add -A && git commit -q -m 'Initial vault scaffold'"
}

_qnap_vault_git_remote() {
    local vault_dir="$1"
    local remote_url="$2"
    _qnap_git_in_container "$vault_dir" "git remote add origin '$remote_url'"
}

_qnap_vault_git_push() {
    local vault_dir="$1"
    _qnap_git_in_container_with_ssh "$vault_dir" \
        "GIT_SSH_COMMAND='ssh -o StrictHostKeyChecking=no' git push -u origin HEAD"
}

# QNAP has no usable host git and the repo is owned by the `synapse` user, so the
# pull runs in a throwaway alpine/git container with the SSH deploy key mounted
# (same pattern as the old update.sh), then ownership is restored afterwards.
#
# The before/after SHA capture and the Dockerfile/requirements.txt change check
# also happen inside this same container, for the same reason — cmd_update_qnap
# must never assume host git works. Results come back as SYNAPSE_*=value lines
# on stdout, which the caller parses; nothing outside the container touches git.
_qnap_git_pull() {
    local pull_output
    pull_output="$(docker run --rm --entrypoint sh \
        -v "$QNAP_DATA_DIR:$QNAP_DATA_DIR" \
        -v "$QNAP_DATA_DIR/ssh/id_ed25519:/root/.ssh/id_ed25519" \
        alpine/git \
        -c "chmod 600 /root/.ssh/id_ed25519 && \
            git config --global --add safe.directory $PROJECT_DIR && \
            cd $PROJECT_DIR && \
            BEFORE=\$(git rev-parse HEAD) && \
            GIT_SSH_COMMAND='ssh -o StrictHostKeyChecking=no' git pull && \
            AFTER=\$(git rev-parse HEAD) && \
            echo \"SYNAPSE_BEFORE_SHA=\$BEFORE\" && \
            echo \"SYNAPSE_AFTER_SHA=\$AFTER\" && \
            if [ \"\$BEFORE\" != \"\$AFTER\" ] && git diff --name-only \"\$BEFORE\" \"\$AFTER\" | grep -qE '^(Dockerfile|requirements\.txt)\$'; then \
                echo SYNAPSE_REBUILD_NEEDED=1; \
            else \
                echo SYNAPSE_REBUILD_NEEDED=0; \
            fi")"

    chown -R synapse "$PROJECT_DIR"

    QNAP_PULL_BEFORE_SHA="$(printf '%s\n' "$pull_output" | sed -n 's/^SYNAPSE_BEFORE_SHA=//p')"
    QNAP_PULL_AFTER_SHA="$(printf '%s\n' "$pull_output" | sed -n 's/^SYNAPSE_AFTER_SHA=//p')"
    QNAP_REBUILD_NEEDED="$(printf '%s\n' "$pull_output" | sed -n 's/^SYNAPSE_REBUILD_NEEDED=//p')"
}

cmd_update_qnap() {
    echo "Pulling latest code..."
    _qnap_git_pull

    if [[ "$QNAP_PULL_BEFORE_SHA" == "$QNAP_PULL_AFTER_SHA" ]]; then
        echo "Already up to date."
        return
    fi

    if [[ "$QNAP_REBUILD_NEEDED" == "1" ]]; then
        echo "Dockerfile or requirements.txt changed — rebuilding image..."
        docker compose --env-file "$ENV_FILE" build
    else
        echo "Code-only change — no rebuild needed."
    fi

    echo "Restarting..."
    docker compose down
    docker compose up -d
    docker compose logs --tail=20
}

_env_var() {
    grep "^$1=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- || true
}

_maybe_scaffold_vault() {
    local current_vault_path
    current_vault_path="$(_env_var VAULT_PATH)"
    if [[ "$TARGET" == "qnap" ]]; then
        # On QNAP, VAULT_PATH is a *container-internal* path (e.g. /app/notes),
        # so a host-side [ -d ] test never passes and would wrongly re-scaffold
        # over a working production vault. Any non-empty value means configured.
        if [ -n "$current_vault_path" ]; then
            return
        fi
    elif [ -n "$current_vault_path" ] && [ -d "$current_vault_path" ]; then
        return
    fi

    echo ""
    echo "No vault configured (VAULT_PATH is unset or points nowhere)."
    read -rp "Scaffold a new one now? [Y/n]: " scaffold_answer
    if [[ "$scaffold_answer" =~ ^[Nn] ]]; then
        echo "Skipping vault scaffolding. Services will have nowhere to write until VAULT_PATH is set."
        return
    fi

    read -rp "Vault path [$PROJECT_DIR/vault]: " new_vault_path
    new_vault_path="${new_vault_path:-$PROJECT_DIR/vault}"

    read -rp "Personal context for the assistant (name, household, location — free text): " personal_context

    PYTHON="$(_detect_python)"
    VAULT_SCAFFOLD_PATH="$new_vault_path" VAULT_SCAFFOLD_CONTEXT="$personal_context" "$PYTHON" -c "
import os
from pathlib import Path
from services.ingestion.vault_scaffold import scaffold
scaffold(Path(os.environ['VAULT_SCAFFOLD_PATH']), os.environ['VAULT_SCAFFOLD_CONTEXT'], Path('vault_template'))
"
    echo "✅ Vault scaffolded at $new_vault_path"

    # Record VAULT_PATH *before* the git step: if git fails, the vault directory
    # already exists and a naive `./synapse setup` retry would otherwise hit
    # scaffold()'s FileExistsError with no way out but a manual rm -rf.
    if grep -q "^VAULT_PATH=" "$ENV_FILE" 2>/dev/null; then
        sed -i.bak "s|^VAULT_PATH=.*|VAULT_PATH=$new_vault_path|" "$ENV_FILE"
        rm -f "$ENV_FILE.bak"
    else
        echo "VAULT_PATH=$new_vault_path" >> "$ENV_FILE"
    fi
    echo "✅ $ENV_FILE updated with VAULT_PATH=$new_vault_path"

    _init_vault_git "$new_vault_path"
}

# Git-initializes a freshly scaffolded vault and optionally wires up a
# remote. Never pushes without an explicit "y" to the second prompt below —
# scaffolding a vault must never silently push anywhere.
#
# Every git step is fail-soft (warn and continue/return, never abort under
# `set -e`), matching vault_sync.py's commit_and_push_if_changed: by the time
# this runs VAULT_PATH is already written to $ENV_FILE, so a git failure must
# not take down the rest of `./synapse setup`.
_init_vault_git() {
    local vault_dir="$1"

    if [[ "$TARGET" == "mac" ]]; then
        (cd "$vault_dir" && git init -q && git add -A && git commit -q -m "Initial vault scaffold") \
            || { echo "⚠️  git init/commit failed (is git configured with user.name/user.email?) — vault left un-versioned at $vault_dir. Continuing."; return 0; }
    else
        _qnap_vault_git_init "$vault_dir" \
            || { echo "⚠️  git init/commit failed — vault left un-versioned at $vault_dir. Continuing."; return 0; }
    fi
    echo "✅ Vault git-initialized at $vault_dir"

    read -rp "Git remote URL for this vault (blank to skip): " vault_remote
    if [ -z "$vault_remote" ]; then
        return 0
    fi

    if [[ "$TARGET" == "mac" ]]; then
        (cd "$vault_dir" && git remote add origin "$vault_remote") \
            || { echo "⚠️  Could not add remote 'origin' — continuing without one."; return 0; }
    else
        _qnap_vault_git_remote "$vault_dir" "$vault_remote" \
            || { echo "⚠️  Could not add remote 'origin' — continuing without one."; return 0; }
    fi
    echo "✅ Remote 'origin' set to $vault_remote"

    read -rp "Push now? [y/N]: " push_answer
    if [[ ! "$push_answer" =~ ^[Yy] ]]; then
        echo "Skipped push — the vault has a remote configured but nothing pushed yet."
        return 0
    fi

    if [[ "$TARGET" == "mac" ]]; then
        (cd "$vault_dir" && git push -u origin HEAD) \
            || { echo "⚠️  Push failed — the vault is committed locally; push it manually from $vault_dir. Continuing."; return 0; }
    else
        _qnap_vault_git_push "$vault_dir" \
            || { echo "⚠️  Push failed — the vault is committed locally; push it manually from $vault_dir. Continuing."; return 0; }
    fi
    echo "✅ Pushed."
}

_prompt_services() {
    PYTHON="$(_detect_python)"
    echo "Available services:"
    "$PYTHON" -c "
from pathlib import Path
from services.ingestion.registry import ServiceRegistry
registry = ServiceRegistry.discover(Path('services/ingestion/services'))
for name, spec in sorted(registry.services.items()):
    print(f'  {name} ({spec.kind}): {spec.description}')
"
    echo ""
    echo "Current ENABLED_SERVICES in $ENV_FILE:"
    grep "^ENABLED_SERVICES=" "$ENV_FILE" 2>/dev/null || echo "  (not set)"
    read -rp "Enter comma-separated services to enable (blank = keep current): " selection
    if [ -n "$selection" ]; then
        if grep -q "^ENABLED_SERVICES=" "$ENV_FILE" 2>/dev/null; then
            sed -i.bak "s|^ENABLED_SERVICES=.*|ENABLED_SERVICES=$selection|" "$ENV_FILE"
            rm -f "$ENV_FILE.bak"
        else
            echo "ENABLED_SERVICES=$selection" >> "$ENV_FILE"
        fi
        echo "✅ $ENV_FILE updated."
    fi
}

case "${1:-}" in
    services) cmd_services ;;
    logs) cmd_logs ;;
    setup)
        if [[ "$TARGET" == "mac" ]]; then cmd_setup_mac; else cmd_setup_qnap; fi
        ;;
    start)
        if [[ "$TARGET" == "mac" ]]; then cmd_start_mac; else cmd_start_qnap; fi
        ;;
    stop)
        if [[ "$TARGET" == "mac" ]]; then cmd_stop_mac "$@"; else cmd_stop_qnap; fi
        ;;
    restart)
        if [[ "$TARGET" == "mac" ]]; then cmd_restart_mac; else cmd_restart_qnap; fi
        ;;
    update)
        if [[ "$TARGET" == "mac" ]]; then cmd_update_mac; else cmd_update_qnap; fi
        ;;
    *)
        echo "Usage: ./synapse {setup|start|stop|restart|update|services|logs}"
        exit 1
        ;;
esac
