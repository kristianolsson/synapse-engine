{
  "cart": {
    "url": "https://www.amazon.com/cart/localmarket?almBrandId=QW1hem9uIEZyZXNo",
    "item_container": ".sc-list-item",
    "item_name": ".sc-product-title .a-truncate-full",
    "item_price": ".sc-product-price",
    "item_qty": "button[role='combobox']",
    "delete_button": "input[data-feature-id='item-delete-button']",
    "qty_input": "input.qs-widget-text-input",
    "qty_increment_button": "[id^='qs-widget-plus-button'] input",
    "qty_decrement_button": "[id^='qs-widget-minus-button'] input",
    "subtotal": "#sc-subtotal-amount-buybox .sc-price"
  },
  "add": {
    "search_url_template": "https://www.amazon.com/s?k={asin}&i=amazonfresh",
    "item_container": "[data-component-type='s-search-result']",
    "add_to_cart_button": "button[aria-label='Add to cart']",
    "qty_increment_button": "button[data-action='a-stepper-increment']",
    "out_of_stock_indicator": null
  },
  "past_purchases": {
    "url": "https://www.amazon.com/afx/lists/pastpurchases/fresh",
    "item_container": "div[id^=\"closedCard-\"]",
    "item_name": ".p13nTitle .a-truncate-full",
    "item_price": ".a-price .a-offscreen"
  },
  "saved_items": {
    "url": "https://www.amazon.com/afx/lists/pastpurchases/fresh",
    "click_selector": "text='Saved Items'",
    "item_container": "div[id^='gridCell-']:not([id^='emptyGridCell-'])",
    "item_name": ".p13nTitle .a-truncate-full",
    "item_price": ".a-price .a-offscreen"
  },
  "search": {
    "url_template": "https://www.amazon.com/s?k={query}&i=amazonfresh",
    "item_container": "[data-component-type=\"s-search-result\"]",
    "item_name": "[data-cy=\"title-recipe\"] h2 span",
    "item_price": "[data-cy=\"price-recipe\"] .a-price .a-offscreen"
  }
}