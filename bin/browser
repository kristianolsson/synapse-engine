#!/usr/bin/env bash
# Browser CLI — drive a persistent headless Firefox session (Playwright).
# Per-session daemon state: /tmp/synapse-browser/<session>/; profiles: ~/.synapse-browser/profiles/
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$SCRIPT_DIR:$PYTHONPATH"
PYTHON="python3"
[ -x "$SCRIPT_DIR/venv/bin/python3" ] && PYTHON="$SCRIPT_DIR/venv/bin/python3"
"$PYTHON" -m services.ingestion.tools.browser_cli "$@"
