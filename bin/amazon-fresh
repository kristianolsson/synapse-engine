#!/usr/bin/env bash
# Amazon Fresh CLI — browse and manage Amazon Fresh groceries via Playwright Firefox.
# Session profile: ~/.amazon-fresh-session/ (created by 'amazon-fresh auth')
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$SCRIPT_DIR:$PYTHONPATH"
PYTHON="python3"
[ -x "$SCRIPT_DIR/venv/bin/python3" ] && PYTHON="$SCRIPT_DIR/venv/bin/python3"
"$PYTHON" -m services.ingestion.tools.amazon_fresh_cli "$@"
