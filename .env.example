# Gmail IMAP/SMTP credentials
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your-ingestion-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password-here

# Whitelisted sender addresses (comma-separated)
ALLOWED_SENDERS=your-personal-email@gmail.com

# Optional: Redirect all system replies here (instead of replying to sender)
# REPLY_TO_ADDRESS=your-personal-email@gmail.com

# Path to the notes vault (absolute path)
VAULT_PATH=/Users/kristianolsson/Documents/code/notes

# Rate limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# Gemini CLI path (defaults to "gemini"; set full path if not in PATH, e.g. via nvm)
# GEMINI_CMD=/path/to/gemini
