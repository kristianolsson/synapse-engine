# Gmail IMAP/SMTP credentials
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your-ingestion-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password-here

# Whitelisted sender addresses (comma-separated)
ALLOWED_SENDERS=your-personal-email@gmail.com

# Optional: Redirect all system replies here (instead of replying to sender)
# REPLY_TO_ADDRESS=your-personal-email@gmail.com

# Path to the notes vault (absolute path). Leave unset (or delete this line)
# and run ./synapse setup to scaffold a fresh vault automatically.
VAULT_PATH=/path/to/notes

# Git identity used for commit signing inside the container (Docker build args, see docker-compose.yml)
# GIT_USER_NAME=Your Name
# GIT_USER_EMAIL=you@example.com

# Rate limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# AI Provider — ordered list (first = default, rest = fallback options on quota errors)
# Example: AI_PROVIDERS=claude,gemini   →  Claude is primary, Gemini offered as fallback
# Legacy single-provider var still works: AI_PROVIDER=gemini
AI_PROVIDERS=gemini

# Gemini CLI path (defaults to "gemini"; set full path if not in PATH, e.g. via nvm)
# GEMINI_CMD=/path/to/gemini

# Antigravity CLI path (defaults to "agy"; set full path if not in PATH)
# AGY_CMD=/path/to/agy
# AGY_TIMEOUT_SECONDS=300

# Telegram bot settings (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ALLOWED_USER_IDS=your-telegram-user-id
TELEGRAM_MAX_FILE_SIZE_MB=10

# Enabled services (comma-separated). Channels: email, telegram (at least one required).
# Tools: calendar, gmail, reminder, etrade, options-bot, amazon-fresh.
ENABLED_SERVICES=email,telegram,calendar,gmail,reminder,etrade,options-bot,amazon-fresh

# Include execution stats (model usage, tool calls) in replies (true/false, default: false)
STATS_ENABLED=false

# Reminder scheduler — scans reminders.json hourly, fires at exact scheduled times.
# REMINDERS_JSON_PATH=reminders/reminders.json  # relative to VAULT_PATH by default

# Google Calendar integration
# 1. Enable Calendar API in Google Cloud Console
# 2. Create OAuth 2.0 Client ID (Desktop), download JSON as credentials.json
# 3. Run: python -m services.ingestion.shared.google_auth
# CALENDAR_CONFIG_PATH=calendars.json
# CALENDAR_TOKEN_PATH=token.json
# CALENDAR_CREDENTIALS_PATH=credentials.json

# E*TRADE integration (used by etrade and options-bot CLIs)
# API keys from developer.etrade.com (create a production app)
ETRADE_CONSUMER_KEY=your-etrade-consumer-key
ETRADE_CONSUMER_SECRET=your-etrade-consumer-secret
# Account credentials for browser-based auth (via wetrade/Playwright)
ETRADE_USERNAME=your-etrade-username
ETRADE_PASSWORD=your-etrade-password
# TOTP secret for 2FA (base32, from your authenticator app setup)
# ETRADE_TOTP_SECRET=your-totp-secret
# Use "sandbox" for testing, "production" for live trading
ETRADE_MODE=production
# Optional: Default account suffix (e.g. 2057) to use when --account is not provided
# ETRADE_ACCOUNT_SUFFIX=your-account-suffix
