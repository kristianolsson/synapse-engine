# Gmail IMAP/SMTP credentials
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_ADDRESS=your-ingestion-email@gmail.com
EMAIL_APP_PASSWORD=your-app-password-here

# Whitelisted sender addresses (comma-separated)
ALLOWED_SENDERS=your-personal-email@gmail.com

# Optional: Redirect all system replies here (instead of replying to sender)
# REPLY_TO_ADDRESS=your-personal-email@gmail.com

# Path to the notes vault (absolute path)
VAULT_PATH=/Users/kristianolsson/Documents/code/notes

# Rate limiting
RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_SECONDS=60

# AI Provider — ordered list (first = default, rest = fallback options on quota errors)
# Example: AI_PROVIDERS=claude,gemini   →  Claude is primary, Gemini offered as fallback
# Legacy single-provider var still works: AI_PROVIDER=gemini
AI_PROVIDERS=gemini

# Gemini CLI path (defaults to "gemini"; set full path if not in PATH, e.g. via nvm)
# GEMINI_CMD=/path/to/gemini

# Telegram bot settings (create via @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your-bot-token-here
TELEGRAM_ALLOWED_USER_IDS=your-telegram-user-id
TELEGRAM_MAX_FILE_SIZE_MB=10

# Enabled channels (comma-separated: email, telegram)
ENABLED_CHANNELS=email

# Include execution stats (model usage, tool calls) in replies (true/false, default: false)
STATS_ENABLED=false

# Reminder scheduler — scans reminders.json hourly, fires at exact scheduled times.
# REMINDERS_JSON_PATH=reminders/reminders.json  # relative to VAULT_PATH by default

# Google Calendar integration
# 1. Enable Calendar API in Google Cloud Console
# 2. Create OAuth 2.0 Client ID (Desktop), download JSON as credentials.json
# 3. Run: python -m services.ingestion.tools.setup_calendar
# CALENDAR_CONFIG_PATH=calendars.json
# CALENDAR_TOKEN_PATH=token.json
# CALENDAR_CREDENTIALS_PATH=credentials.json
